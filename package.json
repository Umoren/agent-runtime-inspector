{
  "name": "agent-runtime-inspector",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Umoren/agent-runtime-inspector.git"
  },
  "bugs": {
    "url": "https://github.com/Umoren/agent-runtime-inspector/issues"
  },
  "homepage": "https://github.com/Umoren/agent-runtime-inspector#readme",
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "ari": "tsx packages/cli/src/index.ts",
    "dev": "tsx packages/cli/src/index.ts dev",
    "proxy": "tsx packages/cli/src/index.ts proxy",
    "web:dev": "pnpm --filter @ari/web dev",
    "docs:dev": "pnpm --filter @ari/docs start",
    "docs:build": "pnpm --filter @ari/docs build",
    "docs:serve": "pnpm --filter @ari/docs serve",
    "example:merge": "pnpm --filter @ari/example-vercel-ai-sdk-merge dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.29.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vitest": "^3.2.0"
  }
}
