{
  "name": "@ari/docs",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "NO_UPDATE_NOTIFIER=1 docusaurus start --host 0.0.0.0 --port 3001 --no-open",
    "build": "NO_UPDATE_NOTIFIER=1 docusaurus build",
    "serve": "NO_UPDATE_NOTIFIER=1 docusaurus serve --host 0.0.0.0 --port 3001 --no-open",
    "clear": "NO_UPDATE_NOTIFIER=1 docusaurus clear",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.1",
    "@docusaurus/preset-classic": "3.10.1",
    "@mdx-js/react": "^3.1.0",
    "clsx": "^2.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.1",
    "@docusaurus/tsconfig": "3.10.1",
    "@docusaurus/types": "3.10.1",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.23",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  }
}
